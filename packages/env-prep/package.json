{
  "name": "@outerlayer/env-prep",
  "version": "0.1.0",
  "description": "prepareEnv behind the SandboxProvider seam: deterministic build + health probe, setup-only agentic repair ladder with hard budgets, escalation queue, content-addressed snapshot cache index — card runs never build environments",
  "license": "Apache-2.0",
  "author": "Magu Studios, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outerlayerai/outerlayer.git",
    "directory": "packages/env-prep"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "sandbox",
    "environment-setup",
    "snapshot-cache",
    "ci-cd"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:env-live": "OUTERLAYER_ENV_PREP_LIVE=1 vitest run --testTimeout 600000 src/__tests__/env-prep.live.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@outerlayer/runner-core": "workspace:*",
    "@outerlayer/task-format": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
