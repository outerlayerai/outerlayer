{
  "roles": [
    "owner",
    "admin",
    "write",
    "read"
  ],
  "groups": [
    {
      "key": "agents",
      "rationale": "Agent sessions are self-by-default: every active role reads its own sessions. Team-wide session read (other members' sessions and transcripts) and agents/capture-tier settings are admin-granted, so they go to owner/admin only.",
      "grants": {
        "agents.sessions.self.read": [
          "owner",
          "admin",
          "write",
          "read"
        ],
        "agents.sessions.team.read": [
          "owner",
          "admin"
        ],
        "agents.settings.write": [
          "owner",
          "admin"
        ]
      }
    },
    {
      "key": "ai_cost_config",
      "rationale": "Org-wide seat-cost configuration (Settings -> AI costs): owner/admin only, like billing \u2014 it is org-level financial config. The dashboard widget that consumes the derived total reads via service_role, so members still see Total Cost of AI without these grants.",
      "grants": {
        "ai_cost_config.delete": [
          "owner",
          "admin"
        ],
        "ai_cost_config.insert": [
          "owner",
          "admin"
        ],
        "ai_cost_config.read": [
          "owner",
          "admin"
        ],
        "ai_cost_config.update": [
          "owner",
          "admin"
        ]
      }
    },
    {
      "key": "api_key",
      "rationale": "API keys: owner/admin/write view and create keys; rotating (update) and revoking (delete) a key is owner/admin only.",
      "grants": {
        "api_key.delete": [
          "owner",
          "admin"
        ],
        "api_key.insert": [
          "owner",
          "admin",
          "write"
        ],
        "api_key.read": [
          "owner",
          "admin",
          "write"
        ],
        "api_key.update": [
          "owner",
          "admin"
        ]
      }
    },
    {
      "key": "app",
      "rationale": "Apps: every role reads; creating, editing, and deleting an app is owner/admin.",
      "grants": {
        "app.delete": [
          "owner",
          "admin"
        ],
        "app.insert": [
          "owner",
          "admin"
        ],
        "app.read": [
          "owner",
          "admin",
          "write",
          "read"
        ],
        "app.update": [
          "owner",
          "admin"
        ]
      }
    },
    {
      "key": "app_member_role",
      "rationale": "Per-app role overrides: every role can see who holds which app role; assigning and revoking overrides is owner/admin.",
      "grants": {
        "app_member_role.delete": [
          "owner",
          "admin"
        ],
        "app_member_role.insert": [
          "owner",
          "admin"
        ],
        "app_member_role.read": [
          "owner",
          "admin",
          "write",
          "read"
        ],
        "app_member_role.update": [
          "owner",
          "admin"
        ]
      }
    },
    {
      "key": "app_policy",
      "rationale": "Governs the app-level publish policy (require_pull_request). Owner/admin only: it is a governance control, and a member who can publish must not be able to remove the review gate. Owner is seeded explicitly because the owner bypass in private.effective_app_permissions (01a-private-authz.sql) returns the owner's org role_permissions set \u2014 an owner not seeded this permission would be denied here.",
      "grants": {
        "app_policy.update": [
          "owner",
          "admin"
        ]
      }
    },
    {
      "key": "audit_log",
      "rationale": "Tenant audit-trail read. Owner/admin only: the trail carries member emails, IPs, and denied-attempt records. The trail is written exclusively by service_role, so there is no insert/update/delete.",
      "grants": {
        "audit_log.read": [
          "owner",
          "admin"
        ]
      }
    },
    {
      "key": "billing",
      "rationale": "Billing: every role sees the plan and usage; changing the subscription (insert/update/delete) is owner only.",
      "grants": {
        "billing.insert": [
          "owner"
        ],
        "billing.read": [
          "owner",
          "admin",
          "write",
          "read"
        ],
        "billing.update": [
          "owner"
        ]
      }
    },
    {
      "key": "context",
      "rationale": "Context mirror: every role reads the mirror; write roles save, update, and delete context files.",
      "grants": {
        "context.delete": [
          "owner",
