    {
      "key": "tenant",
      "rationale": "Organization record: every role reads; write roles edit organization settings. tenant.delete and tenant.insert are deliberately ungranted \u2014 no RLS policy references them, so they conferred nothing. Orgs are created by create_organization_transaction and deleted only by platform admins, both SECURITY DEFINER paths that bypass RLS.",
      "grants": {
        "tenant.read": [
          "owner",
          "admin",
          "write",
          "read"
        ],
        "tenant.update": [
