{
  "name": "@outerlayer/report-card",
  "version": "0.1.0",
  "description": "The Harness Report Card: the shareable verdict (paired delta + CIs, $-per-resolved-task, where-it-breaks) with the integrity rules that ARE the brand — verdict tier always, MDE always, never a naked winner. Shared renderer for the dashboard and the CLI.",
  "license": "Apache-2.0",
  "author": "Magu Studios, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outerlayerai/outerlayer.git",
    "directory": "packages/report-card"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "evals",
    "report-card",
    "benchmarking"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
