{
  "name": "@outerlayer/fleet-slo",
  "version": "0.1.0",
  "description": "Canary-fleet SLOs, a fault-injecting chaos suite, and a release-readiness gate: computes infra-error rate, unattended-completion rate, silent failures, qualify timing, and cost predictability from live trial telemetry and checks them against published thresholds.",
  "license": "Apache-2.0",
  "author": "Magu Studios, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outerlayerai/outerlayer.git",
    "directory": "packages/fleet-slo"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "slo",
    "reliability",
    "chaos-testing",
    "telemetry"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@outerlayer/runner-core": "workspace:*",
    "@outerlayer/task-format": "workspace:*",
    "@outerlayer/trial-harness": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
