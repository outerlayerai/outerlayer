{
  "name": "@outerlayer/eval-stats",
  "version": "0.1.0",
  "description": "Paired statistics for eval report cards: paired bootstrap, Wilson CIs, exact McNemar, MDE, pass@k/pass^k, and tiered verdicts — pure, deterministic, seeded. One source of truth for every number on a card.",
  "license": "Apache-2.0",
  "author": "Magu Studios, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outerlayerai/outerlayer.git",
    "directory": "packages/eval-stats"
  },
  "keywords": [
    "ai-agents",
    "evals",
    "statistics",
    "bootstrap",
    "mcnemar-test",
    "confidence-interval"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
