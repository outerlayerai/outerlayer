{
  "name": "@outerlayer/trial-harness",
  "version": "0.1.0",
  "description": "The trial harness: run one (task × config × trial) — agent in a sandbox, freeze the patch, grade by tests in a FRESH sandbox. Multi-launcher (claude-code, codex). The agent never sees test_patch/gold_patch; agent failures are results, never retried.",
  "license": "Apache-2.0",
  "author": "Magu Studios, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outerlayerai/outerlayer.git",
    "directory": "packages/trial-harness"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "evals",
    "sandbox",
    "claude-code",
    "codex"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:trial-live": "OUTERLAYER_TRIAL_LIVE=1 vitest run --testTimeout 600000 src/__tests__/trial.live.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@outerlayer/runner-core": "workspace:*",
    "@outerlayer/task-format": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
