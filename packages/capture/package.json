{
  "name": "@outerlayer/capture",
  "version": "0.1.0",
  "description": "Tolerant Claude Code transcript parser + copy-out daemon, emitting @outerlayer/session-schema AgentSessions",
  "license": "Apache-2.0",
  "author": "Magu Studios, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outerlayerai/outerlayer.git",
    "directory": "packages/capture"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "transcript-parser",
    "session-capture",
    "jsonl"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@outerlayer/session-schema": "workspace:*",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@repo/model-registry": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.2",
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
