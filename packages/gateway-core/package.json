{
  "name": "@repo/gateway-core",
  "private": true,
  "version": "0.0.0",
  "description": "Runtime-agnostic gateway core — the Hono app, routes, services, lib, and the `runtime/` DI interfaces, extracted from apps/gateway so a Node entrypoint can run the same gateway with no Cloudflare account. Carries ZERO cloudflare:workers / @cloudflare/workers-types / @logtail/edge / @sentry/cloudflare / stripe in its import graph (enforced by scripts/ci/check-gateway-core-imports.mjs). Each entrypoint (Worker, Node) injects its own adapters via buildGatewayContext.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./openapi": "./src/openapi/index.ts",
    "./services": "./src/services/index.ts",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src && node ../../scripts/ci/check-gateway-core-imports.mjs && node ../../scripts/check-no-supabase-test-mocks.mjs gateway-core",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "stryker run"
  },
  "dependencies": {
    "@clickhouse/client-web": "^1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@outerlayer/session-schema": "workspace:*",
    "@repo/adapter-config": "*",
    "@repo/api-key-service": "*",
    "@repo/api-schemas": "workspace:*",
    "@repo/db-types": "*",
    "@repo/ee-license": "workspace:*",
    "@repo/entitlements": "workspace:*",
    "@repo/env-kind": "workspace:*",
    "@repo/environments-service": "*",
    "@repo/git-providers": "workspace:*",
    "@repo/llm-costs": "*",
    "@repo/observability-service": "*",
    "@repo/shared-utils": "workspace:*",
    "@repo/tier-config": "workspace:*",
    "@supabase/supabase-js": "2.111.0",
    "@unkey/cache": "^1.5.0",
    "@unkey/error": "^0.2.0",
    "aws4fetch": "^1.0.20",
    "chanfana": "^3.3.0",
    "hono": "^4.12.21",
    "octokit": "^5.0.3",
    "semver": "^7.7.2",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/test-msw": "*",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.0",
    "msw": "^2.15.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
