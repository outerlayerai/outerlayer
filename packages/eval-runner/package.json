{
  "name": "@outerlayer/eval-runner",
  "version": "0.1.0",
  "description": "The run backend: composes the eval loop end to end — prepare the environment, run the trial matrix, compute paired statistics, then build the report card. Given a repo's tasks and two configs, produces a real report card from real trial execution. The sandbox provider, agent launcher, and env factory are all injected by the caller.",
  "license": "Apache-2.0",
  "author": "Magu Studios, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outerlayerai/outerlayer.git",
    "directory": "packages/eval-runner"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "llm",
    "evals",
    "agent-evaluation",
    "benchmarking"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:loop-live": "OUTERLAYER_LOOP_LIVE=1 vitest run --testTimeout 900000 src/__tests__/loop.live.test.ts",
    "test:agent-live": "OUTERLAYER_AGENT_LIVE=1 vitest run --testTimeout 1800000 src/__tests__/agent.live.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@outerlayer/capture": "workspace:*",
    "@outerlayer/env-prep": "workspace:*",
    "@outerlayer/eval-stats": "workspace:*",
    "@outerlayer/report-card": "workspace:*",
    "@outerlayer/runner-core": "workspace:*",
    "@outerlayer/session-schema": "workspace:*",
    "@outerlayer/task-format": "workspace:*",
    "@outerlayer/trial-harness": "workspace:*"
  },
  "devDependencies": {
    "@outerlayer/provider-e2b": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
