{
  "name": "@outerlayer/insights-core",
  "version": "0.1.0",
  "description": "Deterministic, explainable insight detectors over agent sessions — findings with dollars attached, no LLM. Shared by the local scan and the cloud.",
  "license": "Apache-2.0",
  "author": "Magu Studios, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outerlayerai/outerlayer.git",
    "directory": "packages/insights-core"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "observability",
    "cost-analysis",
    "anomaly-detection",
    "session-analysis"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@outerlayer/session-schema": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
