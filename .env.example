# Root Environment Configuration
# Copy to .env.local (gitignored). `yarn dev` sources this file before running
# turbo, so it is the one place that sets the ports every workspace dev server
# binds to.
#
# Per-app configuration does NOT go here — see apps/tenant-dashboard/.env.example
# and apps/gateway/.dev.vars.example.

# Tenant dashboard port (Next.js). `yarn dev` exports this, so every workspace
# dev server sees it — a second app defaulting to ${PORT} would bind here too
# and lose the race. Each app reads its own variable for that reason.
PORT=3002

# Gateway port (Wrangler / Cloudflare Workers)
GATEWAY_PORT=9001

# Marketing site port (Next.js)
SITE_PORT=9010
