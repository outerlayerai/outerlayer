{
  "name": "gateway",
  "version": "0.0.0",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@repo/eslint-config": "*",
    "@repo/test-msw": "*",
    "@sentry/cli": "^3.6.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "msw": "^2.15.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.0",
    "wrangler": "4.115.0",
    "yaml": "^2.8.3"
  },
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port ${GATEWAY_PORT:-9001}",
    "dev:job": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy --outdir dist --upload-source-maps --var SENTRY_RELEASE:$(sentry-cli releases propose-version)",
    "lint": "eslint src && node ../../scripts/check-no-supabase-test-mocks.mjs gateway",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "test": "vitest run && vitest run -c vitest.workers.config.mts",
    "test:unit": "vitest run",
    "test:workers": "vitest run -c vitest.workers.config.mts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "stryker run",
    "test:mutate:changed": "stryker run --mutate",
    "sentry:sourcemaps": "_SENTRY_RELEASE=$(sentry-cli releases propose-version) && sentry-cli releases new $_SENTRY_RELEASE --org=agentmark --project=node-cloudflare-workers && sentry-cli sourcemaps upload --org=agentmark --project=node-cloudflare-workers --release=$_SENTRY_RELEASE --strip-prefix 'dist/..' dist",
    "postdeploy": "yarn sentry:sourcemaps"
  },
  "dependencies": {
    "@clickhouse/client-web": "^1.4.0",
    "@logtail/edge": "^0.5.7",
    "@opentelemetry/api": "^1.9.0",
    "@repo/entitlements": "workspace:*",
    "@repo/error-reporting-core": "*",
    "@repo/gateway-core": "workspace:*",
    "@repo/observability-service": "*",
    "@repo/tier-config": "workspace:*",
    "@repo/trace-topics": "*",
    "@sentry/cloudflare": "^10.69.0",
    "@supabase/supabase-js": "2.111.0",
    "@unkey/api": "^2.3.2",
    "@unkey/cache": "^1.5.0",
    "hono": "^4.12.21",
    "stripe": "^22.4.0"
  }
}
