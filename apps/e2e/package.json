{
  "name": "@outerlayer/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end tests for the OuterLayer platform using Playwright",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "playwright test",
    "test:pr": "playwright test --project=chromium-pr",
    "test:full": "playwright test --project=chromium-full",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "typescript": "^5.5.3"
  }
}
