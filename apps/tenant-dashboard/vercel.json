{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "ignoreCommand": "cd ../.. && bash scripts/should-deploy.sh tenant-dashboard",
  "installCommand": "cd ../.. && YARN_ENABLE_IMMUTABLE_INSTALLS=false yarn install",
  "crons": [
    {
      "path": "/api/cron/span-usage-notifications",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/worker-reaper",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/pr-session-reconcile",
      "schedule": "30 * * * *"
    }
  ]
}
