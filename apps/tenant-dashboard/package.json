{
  "name": "tenant-dashboard",
  "version": "1.0.6",
  "private": true,
  "scripts": {
    "dev": "bash scripts/build-emails-cached.sh && next dev --port ${PORT:-3002}",
    "build": "yarn email-temp:build && next build",
    "build:proxy": "tsc --project ./proxy/tsconfig.proxy.json --outDir ./proxy/.build",
    "codegen:db": "yarn workspace tenant-dashboard supabase gen types typescript --local > ../../packages/db-types/index.ts",
    "codegen:permissions": "tsx ../../packages/db-types/generate-permissions.ts",
    "migration:create": "supabase migration new",
    "db:reset": "supabase db reset",
    "db:validate": "bash scripts/validate-supabase.sh",
    "migration:up": "supabase migration up",
    "email-temp:build": "tsup ./scripts/index.ts --outDir ./scripts/dist --format esm --external react && yarn email-temp:gen",
    "email-temp:gen": "node ./scripts/dist/index.mjs",
    "gen:openapi": "tsx ./scripts/generate-openapi.ts && yarn gen:api-types",
    "gen:api-types": "openapi-typescript ../../docs/dashboard-openapi.yaml -o ./src/lib/api/generated/types.ts && yarn gen:gateway-types",
    "gen:gateway-types": "openapi-typescript ../../docs/openapi.yaml -o ./src/lib/api/generated/gateway-types.ts",
    "stripe:listen": "stripe listen --forward-to localhost:${PORT:-3002}/api/webhooks/payment",
    "start": "next start",
    "start:proxy": "node ./proxy/.build/proxy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest run --reporter=verbose",
    "test:mutate": "stryker run",
    "test:mutate:changed": "stryker run --mutate",
    "test:mutate:money-auth": "stryker run stryker.config.money-auth.mjs",
    "lint": "eslint . --cache && node ../../scripts/check-no-supabase-test-mocks.mjs tenant-dashboard",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:fix": "eslint . --fix",
    "sup": "supabase",
    "clickhouse:migration:dev": "node ./clickhouse/migrate.mjs --host=http://localhost:8123 --user=default --password=dev_password --db=default --migrations-home=./clickhouse/migrations && node ./clickhouse/ensure-read-user.mjs && node ./clickhouse/ensure-write-user.mjs",
    "clickhouse:read-user:dev": "node ./clickhouse/ensure-read-user.mjs",
    "clickhouse:write-user:dev": "node ./clickhouse/ensure-write-user.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@clickhouse/client": "^1.3.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lint": "^6.8.4",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@iconify/react": "^6.0.2",
    "@logtail/next": "^0.4.0",
    "@milkdown/core": "7.21.3",
    "@milkdown/ctx": "7.21.3",
    "@milkdown/plugin-history": "7.21.3",
    "@milkdown/plugin-listener": "7.21.3",
    "@milkdown/preset-commonmark": "7.21.3",
    "@milkdown/preset-gfm": "7.21.3",
    "@milkdown/prose": "7.21.3",
    "@milkdown/react": "7.21.3",
    "@mui/material": "^9.1.2",
    "@mui/system": "^9.1.2",
    "@mui/utils": "^9.1.1",
    "@mui/x-data-grid": "^9.7.0",
    "@octokit/webhooks": "^14.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@outerlayer/capture": "workspace:*",
    "@outerlayer/locales": "workspace:^",
    "@outerlayer/session-schema": "workspace:*",
    "@react-email/render": "^2.0.0",
    "@repo/api-key-service": "*",
    "@repo/api-schemas": "workspace:*",
    "@repo/context-core": "workspace:*",
    "@repo/context-sync": "workspace:*",
    "@repo/db-types": "*",
    "@repo/design-tokens": "workspace:*",
    "@repo/ee-license": "workspace:*",
    "@repo/entitlements": "workspace:*",
    "@repo/env-kind": "workspace:*",
    "@repo/environments-service": "*",
    "@repo/error-reporting-core": "*",
