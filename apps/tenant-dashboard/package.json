    "@repo/trace-topics": "*",
    "@repo/worker-core": "workspace:*",
    "@sentry/nextjs": "^10.29.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@types/lodash": "^4.14.202",
    "@uiw/react-codemirror": "^4.23.7",
    "@unkey/ratelimit": "^2.1.4",
    "@vercel/otel": "^2.1.0",
    "apexcharts": "^6.6.1",
    "clickhouse-migrations": "^1.4.0",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.0",
    "flags": "^4.0.1",
    "framer-motion": "13.0.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.18.1",
    "next": "^16.2.11",
    "next-nprogress-bar": "^2.4.7",
    "nodemailer": "^9.0.1",
    "notistack": "^3.0.2",
    "numeral": "^2.0.6",
    "octokit": "^5.0.5",
    "openapi-fetch": "^0.17.0",
    "openapi3-ts": "^4.6.1",
    "posthog-js": "^1.314.0",
    "react": "^19.2.1",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.1",
    "react-dropzone": "^20.0.0",
    "react-grid-layout": "^2.2.2",
    "react-hook-form": "^7.68.0",
    "resend": "^6.7.0",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "swr": "^2.3.8",
    "unique-names-generator": "^4.7.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@repo/eslint-config": "*",
    "@repo/test-msw": "*",
    "@repo/transactional": "*",
    "@repo/typescript-config": "*",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
