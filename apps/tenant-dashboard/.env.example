# Tenant Dashboard Environment Configuration
# Copy to .env.local (gitignored) and fill in the values for your machine.
# The Supabase URL and keys come from `npx supabase status` after
# `npx supabase start` in this directory.
#
# All variables below are REQUIRED unless marked as (optional).
# See apps/tenant-dashboard/src/env.ts for validation schema.
# Missing required variables will fail the build.

# =============================================================================
# Server-side Environment Variables
# =============================================================================

# Dev server port (default: 3002)
PORT=3002

# Database
# For local dev, set via Supabase CLI. For production, set in Vercel dashboard.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55502/postgres

# Supabase
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Unkey (invite-throttle rate limiting only)
UNKEY_API_KEY=your_unkey_api_key

# API-key store pepper — HMAC secret for minting/hashing API-key digests.
# Must match the gateway's API_KEY_PEPPER. Generate a random value per env.
API_KEY_PEPPER=your_api_key_pepper

# Billing gate. Defaults to "true", which makes every STRIPE_* var below
# required. Set it to "false" to run without Stripe: customer provisioning is
# skipped, a mock billing service is wired in, and the STRIPE_* vars may all be
# left unset. This is the right setting for self-hosting and for contributors
# who are not working on billing.
BILLING_ENABLED=false

# Stripe — required only when BILLING_ENABLED is not "false".
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_SECRET_WEBHOOK_KEY=whsec_xxx
STRIPE_GROWTH_FLAT_PRICE_ID=price_xxx
STRIPE_TEAM_FLAT_PRICE_ID=price_xxx
STRIPE_GROWTH_USAGE_PRICE_ID=price_xxx
STRIPE_TEAM_USAGE_PRICE_ID=price_xxx
STRIPE_GROWTH_STORAGE_PRICE_ID=price_xxx
STRIPE_TEAM_STORAGE_PRICE_ID=price_xxx
STRIPE_SPAN_METER_ID=mtr_xxx
STRIPE_STORAGE_METER_ID=mtr_xxx

# Shared secret guarding the /api/cron/* endpoints against unauthenticated
# callers. Any random string locally: openssl rand -hex 32
CRON_SECRET=your_cron_secret

# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret

# Shared secret the Cloudflare queue consumer presents to
# /api/internal/pr-comment-refresh. Optional — only needed when the queue is
# deployed; leave unset for self-host without queues.
PR_COMMENT_REFRESH_SECRET=your_pr_comment_refresh_secret

# Email
# Delivery gate — fail-closed. Real email is only sent when this is exactly
# "true", so local development delivers nothing unless you opt in. (optional)
# EMAIL_ENABLED=false
# Provider selection: 'resend' (hosted default) or 'smtp' (self-hosted via Nodemailer).
EMAIL_PROVIDER=resend
# Sender address used by both providers.
FROM_EMAIL=hello@yourdomain.com
# Inbox customer replies land in — FROM_EMAIL may sit on a send-only subdomain
# that bounces them. (optional; falls back to a built-in default when unset)
# REPLY_TO_EMAIL=hello@yourdomain.com

# Resend — required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=re_xxx
# Audience for changelog broadcast emails. Resend-only — broadcasts have no SMTP
# equivalent. (Terms-update notifications send through the normal email path, so
# they work on either provider and don't use this.)
RESEND_BROADCAST_AUDIENCE_ID=your_audience_id

# SMTP (Nodemailer) — required only when EMAIL_PROVIDER=smtp.
# Point these at your own mail server (Google Workspace, AWS SES, Postfix, …).
# SMTP_USER/PASS are optional for unauthenticated relays. SMTP_SECURE=true for
# TLS-on-connect (port 465); leave unset for STARTTLS (port 587).
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# Slack
SLACK_CLIENT_SECRET=your_slack_client_secret

# ClickHouse (analytics) — optional for local dev
# Only needed when running `yarn dev:analytics` or `yarn dev:full`
# CLICKHOUSE_HOST=http://localhost:8123
# CLICKHOUSE_PASSWORD=your_clickhouse_password
# Read identity backing row-policy tenant isolation. Without it, tenant-scoped
# reads authenticate as the writer — which no row policy covers — and isolation
# rests on application-layer WHERE clauses alone. `yarn clickhouse:migration:dev`
# provisions this user locally. Set it in any deployment that stores real data.
# CLICKHOUSE_READ_USER=analytics_reader
# CLICKHOUSE_READ_PASSWORD=your_clickhouse_read_password
# Opt in to application-layer-only isolation when you have not provisioned the
# read user above. Closed by default.
# CLICKHOUSE_ALLOW_UNSCOPED_READS=false

# Security
# Generate a secure random string (min 32 characters): openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your_32_character_encryption_key_here

# OAuth state HMAC secret — used by the dashboard's auth callback handler
# (`/auth/github/callback`) to verify signed state tokens minted by the
# gateway's `POST /v1/apps/:appId/git/connect`.
# MUST be identical to the gateway's `OAUTH_STATE_SECRET` — drift silently
# breaks every signed callback (verify fails → opaque 400). Min 32 chars.
# The dashboard also signs transcript image URLs with it; those are minted
# and verified in the dashboard alone, so rotating the value only invalidates
# image links already on open pages (a reload re-mints them).
OAUTH_STATE_SECRET=your_oauth_state_secret_at_least_32_chars

# Fly Machines API token — optional. Cloud workers and git file removal
# report "unavailable" when it is unset.
# FLY_API_TOKEN=your-fly-api-token

# =============================================================================
# Client-side Environment Variables (NEXT_PUBLIC_*)
# =============================================================================

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Gateway and API endpoints the browser bundle talks to. Both default to the
# hosted gateway, so a local dashboard dispatches runs and opens observer
# sockets against production unless you point them at your own gateway. These
# are baked into the client bundle at build time — restart the dev server after
# changing them. (optional; required to exercise a local gateway)
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:9001
# NEXT_PUBLIC_API_URL=http://localhost:9001

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55501
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# GitHub
NEXT_PUBLIC_GITHUB_INSTALLATION_URL=https://github.com/apps/your-app/installations/new

# Slack
NEXT_PUBLIC_SLACK_CLIENT_ID=your_slack_client_id

# Terms Agreement
NEXT_PUBLIC_TERMS_VERSION=2026-01-10
NEXT_PUBLIC_TERMS_URL=https://www.agentmark.co/terms
NEXT_PUBLIC_PRIVACY_URL=https://www.agentmark.co/privacy

# PostHog Analytics — optional for local dev
# Only needed for product analytics tracking
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# NEXT_PUBLIC_POSTHOG_PROJECT_ID=12345

# Better Stack Observability — optional for local dev
# Only needed for production-grade logging, tracing, and error tracking
# Logs + Traces: Source token from Better Stack Logtail
# NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=your_source_token
# Logs: Ingesting URL from Better Stack (format: https://$INGESTING_HOST)
# NEXT_PUBLIC_BETTER_STACK_INGESTING_URL=https://in.logs.betterstack.com
# Error reporting — Sentry-compatible, vendor-neutral. Point the DSN at Better
# Stack Errors, a self-hosted Sentry, or GlitchTip. Resolved by
# resolveErrorReportingConfig() in @repo/error-reporting-core.
#   - Reporting is ON when a DSN is set and not force-disabled.
#   - Force OFF (no-op) with ERROR_REPORTING_ENABLED=false or
#     ERROR_REPORTING_BACKEND=none — no DSN needs to be removed.
# NEXT_PUBLIC_ERROR_REPORTING_DSN=https://token@your-sentry-host/1
# ERROR_REPORTING_ENABLED=true
# ERROR_REPORTING_BACKEND=sentry
#
# Deprecated legacy name (still honored for one release; prefer the vars above):
# NEXT_PUBLIC_BETTERSTACK_ERRORS_DSN=https://token@errors.betterstack.com/1

# Platform admin — optional, defaults to @outerlayer.ai
# Email domains whose users may hold a platform role. Self-hosters set their own
# organization's domain. Every entry must include the leading '@', or a lookalike
# registration (notexample.com) would satisfy a bare-domain suffix match.
# A matching domain alone grants nothing — a platform_user_role row is still
# required.
# Comma-separate to run two domains during a migration cutover, so existing
# admins aren't locked out the moment the new domain lands.
# NEXT_PUBLIC_PLATFORM_ADMIN_EMAIL_DOMAIN=@your-company.com
# NEXT_PUBLIC_PLATFORM_ADMIN_EMAIL_DOMAIN=@new-company.com,@old-company.com

# =============================================================================
# Development-only Variables (not validated by T3 Env)
# =============================================================================

# Sentry (only add in CI/production for source map uploads)
SENTRY_AUTH_TOKEN=
