{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "@repo/api-schemas": ["../../packages/api-schemas/src/index.ts"],
      "@/*": ["./src/*"],
      "@ee/*": ["./ee/*"]
    },
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "next-env.d.ts", 
    "src/**/*.ts", 
    "src/**/*.tsx",
    "ee/**/*.ts",
    "ee/**/*.tsx", 
    ".next/types/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
