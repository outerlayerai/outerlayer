{
  "name": "integration-tests",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "test": "tsx scripts/setup-db.ts setup && vitest run && tsx scripts/setup-db.ts teardown",
    "test:acceptance": "vitest run --project acceptance",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest run --reporter=verbose",
    "build": "echo 'Integration tests do not need to be built'",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint:fix": "eslint src --fix",
    "db:setup": "tsx scripts/setup-db.ts setup",
    "db:teardown": "tsx scripts/setup-db.ts teardown",
    "db:start": "supabase start",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@clickhouse/client": "^1.3.0",
    "@clickhouse/client-web": "^1.10.0",
    "@logtail/next": "^0.4.0",
    "@repo/api-schemas": "workspace:*",
    "@repo/context-core": "*",
    "@repo/environments-service": "*",
    "@repo/gateway-core": "workspace:*",
    "@repo/observability-service": "*",
    "@repo/transactional": "*",
    "@sentry/nextjs": "^10.29.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "gateway": "workspace:*",
    "next": "^16.2.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "tenant-dashboard": "workspace:*"
  },
  "devDependencies": {
    "@octokit/webhooks": "^14.1.0",
    "@repo/typescript-config": "*",
    "@types/node": "^22.20.1",
    "@types/pg": "^8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "pg": "^8.16.3",
    "supabase": "^2.110.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  }
}
