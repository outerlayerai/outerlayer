{
  "name": "outerlayer-app",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "ci:lint": "yarn turbo lint --concurrency=50% --filter='{./apps/*}' --filter='{./packages/*}'",
    "ci:knip": "knip --no-config-hints",
    "ci:supabase-test-mocks": "node scripts/check-no-supabase-test-mocks.mjs --all",
    "ci:data-access-boundary": "node scripts/check-data-access-boundary.mjs",
    "ci:cross-app-bundling": "node scripts/ci/check-cross-app-bundling.mjs",
    "ci:clickhouse-client-guardrails": "node scripts/ci/check-clickhouse-client-guardrails.mjs",
    "ci:publish-safety": "node scripts/ci/check-publish-safety.mjs",
    "ci:workflow-secret-literals": "node scripts/ci/check-workflow-secret-literals.mjs",
    "ci:api-tenancy": "node scripts/ci/check-api-tenancy-allowlist.mjs",
    "ci:acceptance-coverage": "node scripts/ci/check-acceptance-coverage.mjs",
    "ci:permission-codegen": "node scripts/ci/check-permission-codegen.mjs",
    "ci:migration-versions": "node scripts/ci/check-migration-versions.mjs",
    "ci:stryker-mutate-targets": "node scripts/ci/check-stryker-mutate-targets.mjs",
    "ci:weak-test-assertions": "node scripts/check-weak-test-assertions.mjs",
    "ci:openapi": "yarn gen:openapi",
    "ci:typecheck": "turbo run typecheck --concurrency=50% --filter='{./apps/*}' --filter='{./packages/*}'",
    "ci:unit": "yarn turbo test --concurrency=50% --filter='{./apps/*}' --filter='{./packages/*}' --filter='!integration-tests' --filter='!@outerlayer/e2e'",
    "dev": "set -a; . ./.env.local 2>/dev/null; set +a; turbo dev",
    "dev:email": "turbo dev:email",
    "dev:worker": "turbo dev:worker",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:integration": "turbo test --filter=integration-tests",
    "test:e2e": "turbo test:e2e --filter=@outerlayer/e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "gen:openapi": "yarn workspace gateway gen:openapi",
    "dev:analytics": "cd apps/tenant-dashboard/clickhouse && docker compose up -d && cd ../../.. && set -a; . ./.env.local 2>/dev/null; set +a; turbo dev",
    "dev:full": "bash scripts/dev-full.sh",
    "clean:cache": "echo 'Cleaning build caches...' && du -sh .turbo/cache/ apps/*/.next/cache/ 2>/dev/null; rm -rf .turbo/cache/ apps/*/.next/cache/ && echo '✓ Build caches cleaned'",
    "clean:all": "echo 'Cleaning all caches and build artifacts...' && du -sh .turbo/cache/ apps/*/.next/ node_modules/.cache/ 2>/dev/null; rm -rf .turbo/cache/ apps/*/.next/ node_modules/.cache/ && find . -name '*.tsbuildinfo' -delete && rm -f apps/tenant-dashboard/scripts/dist/.cache-hash && echo '✓ All caches and build artifacts cleaned'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
