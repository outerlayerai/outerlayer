# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backup files — never commit these. A backup copy of an env file is exactly
# how a secret reaches a repo: an editor or shell writes `.bak`/`.bak2` next to
# the real thing and a bulk `git add` sweeps it in. The `[0-9]` variant catches
# numbered backups. Intentionally-tracked fixtures (.dev.vars.ci,
# .dev.vars.example) don't end in .bak. The remaining suffixes are the other
# names editors and shells pick for the same thing — a `.bak`-only rule would
# miss every one of them.
*.bak
*.bak[0-9]
*.backup
*.old
*.orig
*.save
*~

# Scratch space for local investigation. Not a build artifact, so no other rule
# covers it — and it accumulates real captured trace data pulled from a live
# ClickHouse (transcripts, file paths, prompt bodies), which must never be
# committed.
tmp/

# Any other `.dev.vars` derivative is a live secrets file. `*.bak` alone only
# covers names that happen to end in `.bak`, so a tool writing a differently
# suffixed copy slips through — and a copy of `.dev.vars` carries the same
# credentials whatever it is called. Allowlisted below are the two fixtures that
# are deliberately tracked and hold no real values.
.dev.vars.*
!.dev.vars.ci
!.dev.vars.example

# Testing
coverage
playwright-report
test-results
.vercel-bypass-state.json

# Stryker mutation testing artifacts (generated by `test:mutate` / nightly run)
**/reports/mutation/
**/.stryker-tmp/

# Docs review artifacts (per-page reviewer reports and fresh-capture staging).
# Reports live at repo-root .docs-review/ so nothing under docs/ ever picks
# them up.
docs/.review/
.docs-review/

# Turbo
.turbo
.nx

# Vercel
.vercel

# Build Outputs
.next/
out/
build
# Re-include the Mintlify docs "build" subtree (real source files, not build output).
!docs/build/
!docs/build/**
dist
*.tsbuildinfo


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (apps/topics-clustering)
__pycache__/
*.pyc
.venv/

# VSCode workspace
*.code-workspace

# Scratch space. Ad-hoc dumps land here — staging trace exports, agent-session
# transcripts, local filesystem paths — none of which may ever reach a commit.
# Ignored so a `git add .` cannot sweep them in.
tmp/

# Misc
.DS_Store
*.pem
.cubecloud

# Private agent-harness mount (a symlink; no trailing slash — trailing-slash
# patterns do not match symlinks)
.claude

# Playwright MCP console logs
.playwright-mcp/

# Manual test artifacts
manual-test-progress.log
*.test-screenshot.png
test[0-9]*-*.png

