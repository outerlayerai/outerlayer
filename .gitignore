dev-local.sh

.yalc
yalc.lock
.env*.local

# Patch/agent artifacts
.patch-prompt*.txt
.patch-report*.json
.teammate-slot

# Internal working assets (marketing and positioning) — team-local only.
**/competitor-*
.outerlayer/marketing/
.outerlayer/skills/brand/

# Speckit local state
specs/
.specify/current-feature

# CLI local development config (contains webhook secrets). Both the legacy
# `.agentmark/` and the current `.outerlayer/` paths are covered — dropping
# either pattern would un-ignore a secrets file.
.agentmark/dev-config.json
.outerlayer/dev-config.json

# Personal needles for the fixture leak scanner. The committed needle floor in
# sanitize-lib.mjs is generic on purpose — a needle list names what it protects,
# so committing personal identifiers would publish a list of what is worth
# targeting. This file supplies them locally and must never be committed.
packages/session-schema/scripts/.sanitize-extra-needles

# Session screenshots and one-off images always land at the repo root by
# accident; images belong in an app's public/ dir.
/*.png
/*.jpg
/*.gif

# The root CLAUDE.md is committed (a one-line @AGENTS.md import shim); nested
# agent-instruction files are local working files, not part of the public tree.
apps/tenant-dashboard/CLAUDE.md
