# Environment for docker/compose.yml. Copy to docker/.env.selfhost and fill in.
#
#   cp docker/.env.selfhost.example docker/.env.selfhost
#   docker compose -f docker/compose.yml --env-file docker/.env.selfhost up -d
#
# ./docker/selfhost-up.sh writes this file for you, reading the Supabase values
# out of the running CLI instance so they can't drift.
#
# Every value below is a PLACEHOLDER. The four secrets marked GENERATE must be
# replaced with random values before this stack is reachable by anyone else.

# -----------------------------------------------------------------------------
# Supabase — provided by the CLI on the host (`supabase start` in
# apps/tenant-dashboard). Read the real values from `supabase status -o json`:
# API_URL, SECRET_KEY, PUBLISHABLE_KEY, JWT_SECRET.
#
# The host from a container's point of view is `host.docker.internal`, NOT
# 127.0.0.1 — inside the gateway container, loopback is the container itself.
# The port is whatever [api].port is in apps/tenant-dashboard/supabase/config.toml.
# -----------------------------------------------------------------------------
SUPABASE_API_BASE_URL=http://host.docker.internal:55501
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_JWT_SECRET=replace_me_with_the_jwt_secret_from_supabase_status

# The same Supabase instance as seen FROM THE HOST — the dashboard runs on the
# host and sources these (DB_URL from `supabase status`, API url with 127.0.0.1
# in place of host.docker.internal). The compose services never read them.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55502/postgres
SUPABASE_API_URL_FROM_HOST=http://127.0.0.1:55501

# -----------------------------------------------------------------------------
# ClickHouse
# -----------------------------------------------------------------------------
CLICKHOUSE_PASSWORD=replace_me_clickhouse_password
CLICKHOUSE_PORT=8123

# Row-policy read identity. Tenant-scoped reads authenticate as this user; the
# row policies that isolate one tenant's traces from another's are attached to
# its role. Without it, reads run as the writer identity, which no row policy
# covers — app-layer WHERE clauses become the only isolation. Provision it with
# `yarn clickhouse:read-user:dev` in apps/tenant-dashboard.
CLICKHOUSE_READ_USER=analytics_reader
CLICKHOUSE_READ_PASSWORD=replace_me_clickhouse_read_password

# -----------------------------------------------------------------------------
# MinIO — S3-compatible store for span payloads too large to inline into a
# ClickHouse row. These credentials are MinIO's root user, so they are worth
# generating even on a laptop install.
# -----------------------------------------------------------------------------
BLOB_S3_ACCESS_KEY_ID=minioadmin
BLOB_S3_SECRET_ACCESS_KEY=replace_me_minio_password   # GENERATE
BLOB_S3_BUCKET=trace-blobs
MINIO_API_PORT=9300
MINIO_CONSOLE_PORT=9301

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------
GATEWAY_PORT=9001

# How programmatic (API-key) callers are authenticated. Set EXACTLY ONE; the
# gateway refuses to boot with neither.
#
#   SELF_HOST_GATEWAY_SECRET  — clients send this value as their API key. At
#                               least 32 chars: a reachable service accepts it
#                               as a bearer token, so a short one is guessable.
#                               Generate with: openssl rand -base64 32
#
#   SELF_HOST_TRUST_PERIMETER — you authenticate callers at the network layer
#                               (VPN, private network, authenticating ingress)
#                               and the gateway checks nothing. Anyone who
#                               reaches the port and knows an app id gets full
#                               access to that tenant, including spending your
#                               LLM provider credits.
#
# Dashboard/human access is a signed Supabase JWT and is fully tenant-validated
# either way — neither variable affects it.
SELF_HOST_GATEWAY_SECRET=replace_me_with_openssl_rand_base64_32   # GENERATE
SELF_HOST_TRUST_PERIMETER=

# HMAC pepper for API-key digests. Must be byte-identical to the dashboard's
# API_KEY_PEPPER — the dashboard mints keys with it and the gateway verifies
# them against it, so a mismatch rejects every key the UI hands out.
# Generate with: openssl rand -base64 32
API_KEY_PEPPER=replace_me_with_openssl_rand_base64_32   # GENERATE

# -----------------------------------------------------------------------------
# Dashboard (runs on the HOST, not in this compose file — see
# docker/README.md). Kept here so one file holds the whole stack's config;
# selfhost-up.sh exports these when it starts the dashboard.
# -----------------------------------------------------------------------------
# TOKEN_ENCRYPTION_KEY and OAUTH_STATE_SECRET are both 32+ chars.
# Generate each with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace_me_with_openssl_rand_base64_32   # GENERATE
OAUTH_STATE_SECRET=replace_me_with_openssl_rand_base64_32     # GENERATE

# Any email address whose domain you want to hold platform-admin rights.
# Must start with '@' so a lookalike domain can't satisfy it.
NEXT_PUBLIC_PLATFORM_ADMIN_EMAIL_DOMAIN=@example.com
FROM_EMAIL=outerlayer@example.com
